              "raw": "{\n  \"SubscriptionName\": \"<string>\",\n  \"SnsTopicArn\": \"<string>\",\n  \"SourceType\": \"<string>\",\n  \"EventCategories\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"SourceIds\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"Enabled\": \"<boolean>\",\n  \"Tags\": [\n    {\n      \"Key\": \"<string>\",\n      \"Value\": \"<string>\",\n      \"ResourceArn\": \"<string>\"\n    },\n    {\n      \"Key\": \"<string>\",\n      \"Value\": \"<string>\",\n      \"ResourceArn\": \"<string>\"\n    }\n  ]\n}",
