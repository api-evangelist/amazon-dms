              "raw": "{\n  \"Data\": [\n    {\n      \"DatabaseId\": \"<string>\",\n      \"Settings\": {\n        \"InstanceSizingType\": \"<string>\",\n        \"WorkloadType\": \"<string>\"\n      }\n    },\n    {\n      \"DatabaseId\": \"<string>\",\n      \"Settings\": {\n        \"InstanceSizingType\": \"<string>\",\n        \"WorkloadType\": \"<string>\"\n      }\n    }\n  ]\n}",
